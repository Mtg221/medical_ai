      "Body_upload_document_endpoint_api_v1_documents_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "dataset_id": {
            "type": "string",
            "title": "Dataset Id",
            "default": "ds_synth_bilingual_v1"
          },
          "subject_id": {
            "type": "string",
            "title": "Subject Id",
            "default": "subj_synth_001"
          },
          "family_id": {
            "type": "string",
            "title": "Family Id",
            "default": "fam_synth_upload"
          },
          "split_assignment": {
            "type": "string",
            "title": "Split Assignment",
            "default": "unassigned"
          },
          "encounter_date_iso": {
            "type": "string",
            "title": "Encounter Date Iso",
            "default": "2026-06-01"
          },
          "specialty": {
            "type": "string",
            "title": "Specialty",
            "default": "INTERNAL_MEDICINE"
          },
          "document_type": {
            "type": "string",
            "title": "Document Type",
            "default": "CLINICAL_NOTE"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_document_endpoint_api_v1_documents_upload_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestDocumentRequest": {
        "properties": {
          "filename": {
            "type": "string",
            "title": "Filename",
            "default": "uploaded_note.txt"
          },
          "text": {
            "type": "string",
            "title": "Text",
            "default": ""
          },
          "content_base64": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Base64"
          },
          "dataset_id": {
            "type": "string",
            "title": "Dataset Id",
            "default": "ds_synth_bilingual_v1"
          },
          "subject_id": {
            "type": "string",
            "title": "Subject Id",
            "default": "subj_synth_001"
          },
          "family_id": {
            "type": "string",
            "title": "Family Id",
            "default": "fam_synth_upload"
          },
          "split_assignment": {
            "type": "string",
            "title": "Split Assignment",
            "default": "unassigned"
          },
          "encounter_date_iso": {
            "type": "string",
            "title": "Encounter Date Iso",
            "default": "2026-06-01"
          },
          "specialty": {
            "type": "string",
            "title": "Specialty",
            "default": "INTERNAL_MEDICINE"
          },
          "document_type": {
            "type": "string",
            "title": "Document Type",
            "default": "CLINICAL_NOTE"
          }
        },
        "type": "object",
        "title": "IngestDocumentRequest"
      },
      "JobStatusResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "institution_id": {
            "type": "string",
            "title": "Institution Id"
          },
          "actor_user_id": {
            "type": "string",
            "title": "Actor User Id"
          },
          "job_type": {
            "type": "string",
            "title": "Job Type"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "RUNNING",
              "SUCCEEDED",
              "FAILED"
            ],
            "title": "Status"
          },
          "progress_pct": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Progress Pct"
          },
          "current_stage": {
            "type": "string",
            "title": "Current Stage"
          },
          "result": {
